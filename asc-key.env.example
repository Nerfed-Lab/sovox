# App Store Connect API key. Copy to asc-key.env and fill in.
# Neither ID is a secret; both are shown on the Integrations page to anyone
# with access to the account. The .p8 never leaves ~/.appstoreconnect.
ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ASC_TEAM_ID=XXXXXXXXXX
